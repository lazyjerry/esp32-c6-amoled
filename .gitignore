.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# IDF component manager 下載物，靠 dependencies.lock 還原
managed_components/

# 由 sdkconfig.defaults 產生，每個 env 一份
sdkconfig.*
!sdkconfig.defaults

# 16MB 原廠韌體 dump，只留本機
backup/

.DS_Store

# gen-content.sh 的產物，語料原始檔在 data/
spiffs_content/

# Python 匯入產生器腳本時留下的
scripts/__pycache__/

# 跑完就沒有下次的腳本。留在本機當紀錄，但不該出現在版控裡讓人以為是日常工具，
# 各支的當時用途與「為什麼不會再跑」寫在 scripts/one-time/README.md
scripts/one-time/

# 施工筆記工具的工作目錄，屬個人流程不屬專案
docs/working-notes-skill/
