# 實測本板為 16MB；board 定義給的值不對，image header 會寫錯導致開機警告
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB-C 直連 SoC，UART0 沒有接出來
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- HTTPS 取天氣 ---
# 走 esp-tls 的內建根憑證組，不用自己帶 api.open-meteo.com 的憑證
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS handshake 期間 mbedTLS 需要的緩衝，預設 16KB 在小記憶體上太吃緊
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
# UI 文字一律指定自產的中文子集字型；Montserrat 14 留著只是 LVGL 的 default font
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
# 配網畫面要畫 QR
CONFIG_LV_USE_QRCODE=y

# --- SoftAP 配網 ---
# IDF 6.0 預設只開 security v2（SRP6a，要預先產 salt/verifier）；
# ESP SoftAP Prov App 的 PoP 流程走 v1，要自己打開
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# main task 要跑 LVGL 初始化與 HTTPS，預設 3584 不夠
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
