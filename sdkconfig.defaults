# 實測本板為 16MB；board 定義給的值不對，image header 會寫錯導致開機警告
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB-C 直連 SoC，UART0 沒有接出來
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
# UI 文字一律指定自產的中文子集字型；Montserrat 14 留著只是 LVGL 的 default font
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48

# main task 要跑 LVGL 初始化，預設 3584 不夠
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
